# Project-level bunfig.toml — drop this in repo root and commit it.
# Same reasoning as the .npmrc template: ~/.bunfig.toml does not reach CI.
#
# Safe to commit. No secrets here.

[install]
# Refuse package versions younger than 7 days (in seconds).
# bun 1.3+ honors this; older bun ignores it (no harm, just no protection).
minimumReleaseAge = 604800   # 7 * 24 * 60 * 60
