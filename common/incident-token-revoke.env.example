# incident-token-revoke.env.example
#
# Optionele mail-rapportage voor common/incident-token-revoke.sh.
# Zonder dit bestand stuurt het script GEEN mail — alles blijft lokaal in
# /tmp/incident-<ts>/ (en alleen daar als er artefacten zijn).
#
# Gebruik:
#   mkdir -p ~/.config/workstation-security
#   cp common/incident-token-revoke.env.example ~/.config/workstation-security/mail.env
#   chmod 600 ~/.config/workstation-security/mail.env
#   $EDITOR ~/.config/workstation-security/mail.env
#
# Het script weigert te mailen als de file niet op mode 600 (of 400) staat —
# bevat namelijk een SMTP-wachtwoord.
#
# Gmail specifiek:
#   - 2FA moet aan staan op je Google-account.
#   - Maak een "App Password" via https://myaccount.google.com/apppasswords
#     (NIET je gewone Google-wachtwoord — dat werkt niet via SMTP).
#   - MAIL_USER en MAIL_FROM moeten matchen met het Google-account.

# --- SMTP server ---
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465

# --- Afzender ---
MAIL_FROM=incident@example.com
MAIL_FROM_NAME="Workstation IR"

# --- Bestemming (één adres; mag groepslijst zijn) ---
MAIL_TO=security@example.com

# --- SMTP-auth (Gmail: App Password, niet je login-wachtwoord) ---
MAIL_USER=incident@example.com
MAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
